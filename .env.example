# Copy to .env and fill in. Never commit .env.
# Every setting is read in src/config/index.js; the server checks them at start-up
# and refuses to start with missing or unsafe values.

# --- Required ------------------------------------------------------------------
# Long random string (32+ chars). Encrypts each company's signing key and signs
# login sessions. There is no fallback: the server won't start without it.
# If you lose it, existing signing keys can't be decrypted. Generate one with:
#   openssl rand -base64 48
APP_SECRET=

# Public https:// address of this server (required in production). It is printed
# inside every QR code, so set it before issuing real documents and never change it.
PUBLIC_BASE_URL=http://localhost:3100

NODE_ENV=development
PORT=3100

# --- Database ------------------------------------------------------------------
# Either DATABASE_URL...
# DATABASE_URL=postgres://user:pass@host:5432/certificate_generator
# ...or the individual settings. (Docker Compose's Postgres is on port 5433.)
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=certificate_generator
PGSSL=false
# Connections per process.
# PG_POOL_SIZE=10
# The schema only changes through migrations (npm run db:migrate). A server with
# pending migrations refuses to start, unless this is true (runs them first) —
# convenient for a single server, but run them as a deploy step when you have several.
# MIGRATE_ON_START=false

# --- File storage (issued PDFs and uploaded PDF forms) ----------------------------
# "local": a folder on this machine. Fine for one server; back it up with the database.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# "s3": any S3-compatible store (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO),
# needed when you run more than one server.
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                 # leave empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=            # leave both empty to use the machine's IAM role
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false    # true for MinIO
# S3_PREFIX=                   # optional folder inside the bucket

# --- Redis (optional) -----------------------------------------------------------------
# Shares rate-limit counters and dashboard previews between servers. Without it
# both stay in this process's memory, which is fine for one server.
# (Docker Compose: npm run redis:up, then REDIS_URL=redis://127.0.0.1:6380)
# REDIS_URL=redis://127.0.0.1:6379

# --- Background jobs (making official PDFs) -----------------------------------------
# Every server runs a worker unless RUN_WORKER=false. To run PDF work on separate
# machines, set RUN_WORKER=false on the web servers and run `npm run worker` there.
# RUN_WORKER=true
# WORKER_CONCURRENCY=2         # jobs at once per worker
# RENDER_CONCURRENCY=2         # Chrome pages at once per process (previews, PDFs)

# --- Logs and error tracking ------------------------------------------------------------
# JSON logs on stdout. Levels: fatal, error, warn, info, debug. Readable locally with:
#   npm run dev | npx pino-pretty
# LOG_LEVEL=info
# Report errors to Sentry (or any Sentry-compatible service). Off when empty.
# SENTRY_DSN=

# --- Access and behaviour -------------------------------------------------------------
APP_NAME=DocTrust
# Set to false to stop public self-sign-up (you then create companies yourself).
ALLOW_SIGNUP=true
# Only these IP addresses can reach the staff dashboard (/platform), comma-separated.
# PLATFORM_ALLOWED_IPS=203.0.113.10,203.0.113.11
# Behind a reverse proxy or load balancer (nginx, Render, Railway…): true or a hop count.
# Needed for correct client IPs in rate limits, logs and PLATFORM_ALLOWED_IPS.
# TRUST_PROXY=1
# Sign-in attempts per 15 minutes per IP, and verify-page requests per minute per IP.
# AUTH_RATE_LIMIT=20
# PLATFORM_AUTH_RATE_LIMIT=10
# VERIFY_RATE_LIMIT=60
# Hosts HTML templates may load fonts/scripts from when rendering. Everything else is blocked.
# RENDER_ALLOWED_HOSTS=cdn.tailwindcss.com,fonts.googleapis.com,fonts.gstatic.com,cdn.jsdelivr.net,cdnjs.cloudflare.com
# Company whose imported certificates answer old QR codes (/report/<number>).
# LEGACY_ORG_SLUG=

# --- Chrome (used to make PDFs) -----------------------------------------------------------
# Use a system Chrome instead of Puppeteer's download (e.g. in Docker, or if
# `npx puppeteer browsers install chrome` isn't possible).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Only when Chrome can't use its sandbox (e.g. running as root in a container).
# PUPPETEER_NO_SANDBOX=true
