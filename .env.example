# Copy to .env and fill in. Never commit .env.

# --- Required in production -------------------------------------------------
# Long random string (32+ chars). Encrypts each company's signing key and signs
# login sessions. If you lose it, existing signing keys can't be decrypted.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
APP_SECRET=

# Public address of this server. It is printed inside every QR code, so set it
# before issuing real documents and don't change it afterwards.
PUBLIC_BASE_URL=http://localhost:3100

NODE_ENV=development
PORT=3100

# --- Database -----------------------------------------------------------------
# Either DATABASE_URL...
# DATABASE_URL=postgres://user:pass@host:5432/certificate_generator
# ...or the individual settings:
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=certificate_generator
PGSSL=false
# Auto-create/alter tables on start. Turn off once you move to migrations.
DB_SYNC=true

# --- Storage --------------------------------------------------------------------
# Where issued PDFs are kept. Back this up together with the database.
STORAGE_DIR=./storage

# --- Optional -----------------------------------------------------------------
APP_NAME=DocTrust
# Set to false to stop public self-sign-up (you then create companies yourself).
ALLOW_SIGNUP=true
# Hosts templates may load fonts/scripts from when rendering. Everything else is blocked.
# RENDER_ALLOWED_HOSTS=cdn.tailwindcss.com,fonts.googleapis.com,fonts.gstatic.com,cdn.jsdelivr.net,cdnjs.cloudflare.com
# Company whose imported certificates answer old QR codes (/report/<number>).
# LEGACY_ORG_SLUG=
# Behind a reverse proxy (nginx, Render, Railway…): set to true or a hop count.
# TRUST_PROXY=1
# Use a system Chrome instead of Puppeteer's download; needed as root in Docker.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_NO_SANDBOX=true
